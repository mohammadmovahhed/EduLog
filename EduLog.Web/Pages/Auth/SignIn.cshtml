@page
@model EduLog.Web.Pages.Auth.SignInModel
@{
    Layout = "_AuthLayout";
}

<h2>ورود به حساب کاربری</h2>
<form method="post">
    <div asp-validation-summary="All" style="color: red"></div>

    <div class="input-box">
        <input asp-for="UserName" type="text" placeholder="ایمیل خود را وارد کنید">
        <span asp-validation-for="UserName" style="color:red"></span>
    </div>
    <div class="input-box">
        <input asp-for="Password" type="password" placeholder="کلمه عبور را وارد کنید">
        <span asp-validation-for="Password" style="color:red"></span>
    </div>
    <div class="input-box button">
        <input type="submit" value="ورود">
    </div>
    <div class="text">
        <h3>حساب کاربری ندارید؟ <a asp-page="SignUp">ثبت‌نام کنید</a></h3>
    </div>
</form>